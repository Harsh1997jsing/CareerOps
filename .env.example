# Copy this to .env and fill in real values. Never commit .env itself.

ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

DATABASE_URL=postgresql://careerops:careerops@localhost:5432/careerops

ENVIRONMENT=development

# MCP explore sources (app/sources/mcp/) — optional. A source is only
# used once both its URL and key are set; see app/sources/mcp/registry.py.
# Never LinkedIn or Naukri — see CLAUDE.md rule 2.
JOBO_MCP_URL=https://jobs-mcp.jobo.world/mcp
JOBO_MCP_API_KEY=
HASDATA_MCP_URL=
HASDATA_MCP_API_KEY=

# app/api/ (FastAPI) — CORS origin allowed to call it, i.e. where
# ../frontend's dev server runs. Vite's default is 5173.
FRONTEND_ORIGIN=http://localhost:5173

# Multi-tenant JWT Authentication — both required, no code-level default
# (the app fails to start without them, on purpose — a secret sitting in
# source control isn't a "default"). Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Protected Default Admin — required, no code-level default. Pick your own
# password; this account is created automatically on first API startup.
DEFAULT_ADMIN_EMAIL=admin@careerops.local
DEFAULT_ADMIN_PASSWORD=

